# Copy to server/.env and edit
# SQLite database file, relative to server/ (created on first start)
DB_FILE=data/fleetpilot.db

PORT=3001
# Comma-separated list of origins allowed to call the API (your Vite/served app URL)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
# Shared secret sent as x-api-key. Leave blank to disable (LAN/dev only).
API_KEY=
